# Copy this file to .env and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the client.

# Firebase (Authentication + Realtime Database)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The single owner. Create this account once in the Firebase console (owners do
# not register through the app); this email is what grants owner access.
VITE_OWNER_EMAIL=admin@stayinkochi.com

# json-server API (separate `server/` folder).
# Local: `npm run server`. Deployed: paste the API's public URL here.
VITE_API_BASE_URL=http://localhost:5000
