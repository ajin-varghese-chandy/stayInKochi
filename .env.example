# Copy this file to .env and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the client.

# Firebase (Authentication + Realtime Database)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The single owner. Create this account once in the Firebase console (owners do
# not register through the app); this email is what grants owner access.
VITE_OWNER_EMAIL=admin@stayinkochi.com

# json-server (local REST API)
VITE_API_BASE_URL=http://localhost:5000

# Cloudinary (image uploads, e.g. maintenance photos)
# Signed uploads: the api secret stays on the server (server/index.js).
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Razorpay (rent payments)
# Served to the client by server/index.js; RAZORPAY_KEY_SECRET stays server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
